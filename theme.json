{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "customDuotone": true,
      "link": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#052FE7",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#FF224A",
          "name": "Secondary"
        },
        {
          "slug": "primary-shade-one",
          "color": "#1D47FF",
          "name": "Primary Shade 1"
        },
        {
          "slug": "primary-shade-2",
          "color": "#293635",
          "name": "Primary Shade 2"
        },
        {
          "slug": "secondary-shade-1",
          "color": "#BB26FF",
          "name": "Secodnary Shade 1"
        },
        {
          "slug": "secondary-shade-2",
          "color": "#202327",
          "name": "Secodnary Shade 2"
        },
        {
          "slug": "light-color",
          "color": "#FFFFFE",
          "name": "Light Color"
        },
        {
          "slug": "black-color",
          "color": "#000000",
          "name": "Black Color"
        },
        {
          "slug": "dark-shade",
          "color": "#011A16",
          "name": "Dark Shade"
        },
        {
          "slug": "heading-color",
          "color": "#00061F",
          "name": "Heading Color"
        },
        {
          "slug": "background",
          "color": "#00061F",
          "name": "Background"
        },
        {
          "slug": "background-alt",
          "color": "#F4F6FF",
          "name": "Background Alt"
        },
        {
          "slug": "foreground",
          "color": "#646464",
          "name": "Foreground"
        },
        {
          "slug": "foreground-alt",
          "color": "#D9D9D9",
          "name": "Foreground Alternative"
        },
        {
          "slug": "meta-color",
          "color": "#6A6A6A",
          "name": "Meta Color"
        },
        {
          "slug": "border-color",
          "color": "#00061F1A",
          "name": "Border Color"
        },
        {
          "slug": "sticky-bg-color",
          "color": "#021411",
          "name": "Sticky Background Color"
        },
        {
          "color": "#ffffff00",
          "name": "Transparent",
          "slug": "transparent"
        }
      ],
      "duotone": [
        {
          "colors": ["#052FE7", "#FF224A"],
          "slug": "primary-secondary",
          "name": "Duo 1"
        },
        {
          "colors": ["#FF224A", "#052FE7"],
          "slug": "secondary-primary",
          "name": "Duo 2"
        },
        {
          "colors": ["#052FE7", "#FFFFFE"],
          "slug": "primary-light",
          "name": "Duo 3"
        },
        {
          "colors": ["#FF224A", "#FFFFFE"],
          "slug": "dark-shade",
          "name": "Dark Shade"
        },
        {
          "colors": ["#052FE7", "#9F05F8"],
          "slug": "primary-shade",
          "name": "Duo 4"
        },
        {
          "colors": ["#9F05F8", "#000000"],
          "slug": "primary-dark",
          "name": "Duo 5"
        },
        {
          "colors": ["#000000", "#9F05F8"],
          "slug": "dark-primary",
          "name": "Duo 6"
        },
        {
          "colors": ["#9F05F8", "#FFFFFE"],
          "slug": "shade-light",
          "name": "Duo 7"
        },
        {
          "colors": ["#FFFFFE", "#9F05F8"],
          "slug": "light-shade",
          "name": "Duo 8"
        },
        {
          "colors": ["#052FE7", "#000000"],
          "slug": "secondary-dark",
          "name": "Duo 9"
        },
        {
          "colors": ["#000000", "#052FE7"],
          "slug": "dark-secondary",
          "name": "Duo 10"
        },
        {
          "colors": ["#FFFFFE", "#052FE7"],
          "slug": "light-primary",
          "name": "Duo 11"
        }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(170deg, var(--wp--preset--color--primary) 70%, var(--wp--preset--color--primary-shade-one) 70%);",
          "name": "Gradient 1",
          "slug": "gradient-1"
        },
        {
          "gradient": "linear-gradient(90deg, var(--wp--preset--color--black-color) 0%, transparent 10.2%, transparent 20.19%, transparent 100%);",
          "name": "Gradient 2",
          "slug": "gradient-2"
        },
        {
          "gradient": "radial-gradient(50% 75% at 50% 50%, var(--wp--preset--color--secondary) 0%, var(--wp--preset--color--background) 55.33%);",
          "name": "Gradient 3",
          "slug": "gradient-3"
        }
      ],
      "shadow": {
        "presets": [
          {
            "name": "Soft Shadow",
            "slug": "soft",
            "shadow": "0px 4px 4px 0px var(--wp--preset--color--border-color)"
          },
          {
            "name": "Medium Shadow",
            "slug": "medium",
            "shadow": "0px 0px 10px 0px var(--wp--preset--color--border-color);"
          },
          {
            "name": "Hard Shadow",
            "slug": "hard",
            "shadow": "0px 4px 34px 0px var(--wp--preset--color--border-color);"
          }
        ]
      }
    },
    "typography": {
      "dropCap": true,
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "12px",
          "name": "Extra Small"
        },
        {
          "slug": "small",
          "size": "14px",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "16px",
          "name": "Normal"
        },
        {
          "slug": "medium",
          "size": "18px",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "20px",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "24px",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "28px",
          "name": "2X Large"
        },
        {
          "slug": "xxx-large",
          "size": "34px",
          "name": "3X Large"
        },
        {
          "slug": "jumbo",
          "size": "44px",
          "name": "Jumbo"
        },
        {
          "slug": "mega",
          "size": "56px",
          "name": "Mega"
        },
        {
          "slug": "giga",
          "size": "60px",
          "name": "Giga"
        }
      ],
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Poppins",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Poppins/Poppins-Regular.ttf"]
            },
            {
              "fontFamily": "Poppins",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": ["file:./assets/fonts/Poppins/Poppins-SemiBold.ttf"]
            },
            {
              "fontFamily": "Poppins",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": ["file:./assets/fonts/Poppins/Poppins-Bold.ttf"]
            }
          ],
          "fontFamily": "\"Poppins\", sans-serif",
          "name": "Poppins",
          "slug": "poppins"
        },
        {
          "fontFace": [
            {
              "fontFamily": "Public Sans",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "src": [
                "file:./assets/fonts/Public_Sans/PublicSans-VariableFont_wght.ttf"
              ]
            }
          ],
          "fontFamily": "\"Public Sans\", sans-serif",
          "name": "Public Sans",
          "slug": "public-sans"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--public-sans)",
      "fontSize": "var(--wp-preset--font-size--normal)",
      "color": "var(--wp--preset--color--foreground)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "button": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size-normal)",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "bottom": "16px",
            "left": "32px",
            "top": "16px",
            "right": "32px"
          }
        },
        "border": {
          "radius": "0px"
        },
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--light-color)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--black-color)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--giga)",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--mega)",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--jumbo)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "500",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "500"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--normal)",
          "fontWeight": "500"
        }
      },
      "heading": {
        "color": "var(--wp-preset--color--heading-color)",
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontStyle": "normal",
          "fontWeight": "800",
          "lineHeight": "var(--wp--preset--line-height--xxSmall)"
        }
      }
    },
    "color": {
      "background": "var(--wp--preset--color--light-color)",
      "text": "var(--wp--preset--color--foreground)"
    }
  }
}
